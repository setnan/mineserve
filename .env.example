# ====================================================================
#  Minecraft server config. Copy to .env, fill in the <...> values, then: ./mc.sh restart
#  All variables: https://docker-minecraft-server.readthedocs.io/en/latest/variables/
#  .env holds secrets (RCON password, playit key) and player names: never commit it.
# ====================================================================

# --- Server / version ---------------------------------------------------
# PAPER is needed for the Creator plugin, the datapack works on any type.
TYPE=PAPER
VERSION=26.3
# Java heap. 2G-4G is enough for a few players. Keep CONTAINER_MEMORY_LIMIT ~1 GB above MEMORY.
MEMORY=3G
CONTAINER_MEMORY_LIMIT=4G
TZ=Europe/Oslo
MOTD=Welcome to the server
MAX_PLAYERS=10
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
# true = only real Minecraft accounts can join (recommended)
ONLINE_MODE=true

# --- World --------------------------------------------------------------
LEVEL=world
# Empty = random seed
SEED=
# minecraft:normal | minecraft:flat | minecraft:large_biomes | minecraft:amplified
LEVEL_TYPE=minecraft:normal
GENERATE_STRUCTURES=true
ALLOW_NETHER=true
# Optional saved world: put a zip/folder in worlds/ and set e.g. WORLD=/worlds/myworld.zip
# (used only on first start, or always with FORCE_WORLD_COPY=true)
#WORLD=/worlds/myworld
FORCE_WORLD_COPY=false

# --- Rules --------------------------------------------------------------
MODE=survival
FORCE_GAMEMODE=false
DIFFICULTY=normal
HARDCORE=false
PVP=true
SPAWN_MONSTERS=true
SPAWN_ANIMALS=true
SPAWN_NPCS=true
SPAWN_PROTECTION=0
ALLOW_FLIGHT=false
# The storage system and all tools are datapack functions, command blocks are not needed.
ENABLE_COMMAND_BLOCK=false

# --- Permissions ----------------------------------------------------------
# Comma-separated Java profile names. Only ops can use cheats (/gamemode, /give, /tp …).
OPS=<your_name>
OP_PERMISSION_LEVEL=4
FUNCTION_PERMISSION_LEVEL=2
EXISTING_OPS_FILE=SYNCHRONIZE

ENABLE_WHITELIST=true
WHITELIST=<your_name>,<friend>
EXISTING_WHITELIST_FILE=SKIP
ENFORCE_WHITELIST=true

# --- RCON (used by mc.sh, chatbro.py and the backup container, never by players) ---
ENABLE_RCON=true
RCON_PASSWORD=<generate one: openssl rand -hex 16>
BROADCAST_RCON_TO_OPS=false

# --- Backup ---------------------------------------------------------------
# ./mc.sh backup takes a snapshot; schedule it with cron/launchd. The container itself never runs on its own.
BACKUP_INTERVAL=3650d
PRUNE_BACKUPS_DAYS=0
PRUNE_BACKUPS_COUNT=4

# --- Misc -------------------------------------------------------------------
ENABLE_AUTOPAUSE=false
SNOOPER_ENABLED=false
USE_AIKAR_FLAGS=true

# --- Plugins ----------------------------------------------------------------
# Multiverse (several worlds), LuckPerms (permissions, used for creator.craft), FastAsyncWorldEdit
# (/copyarea, /paste, /undo aliases in data/commands.yml). Creator.jar is built from plugins-src/creator.
MODRINTH_PROJECTS=multiverse-core,multiverse-inventories,multiverse-netherportals,luckperms,multiverse-inventoriesimporter,fastasyncworldedit

# --- Tunnel (playit.gg, optional) ---------------------------------------------
# Lets players outside your home network join. Paste the key from playit.gg and set COMPOSE_PROFILES=playit.
PLAYIT_SECRET_KEY=
COMPOSE_PROFILES=
# Console pipe, makes mc-send-to-console work
CREATE_CONSOLE_IN_PIPE=true

# --- Resource pack (player heads, custom items; built by ./mc.sh heads) ---------
# Served by the mc-pack nginx container on port 8080. Use an address the players can reach.
RESOURCE_PACK=http://<your-lan-ip>:8080/supermann-heads.zip
RESOURCE_PACK_ENFORCE=false
RESOURCE_PACK_PROMPT={"text":"Supermann: shows the heads of the other players on the locator bar and draws the custom items"}
# Written by heads.py
RESOURCE_PACK_SHA1=

# --- Settings for mc.sh and the scripts (not used by the container) ---
# Worlds where players have no cheats and ops get them temporarily with ./mc.sh world-gm / cheat (LuckPerms)
MC_RESTRICTED_WORLDS=
MC_CHEAT_GROUP=cheat
# Markdown notes kept up to date by worlds.py and read by blueprints.py (GrabCraft links)
MC_WORLDS_NOTE=notes/worlds.md
MC_BLUEPRINTS_NOTE=notes/blueprints.md
# launchd label of the chat bridge on macOS (service/mc-chatbro.plist.example); Linux uses the systemd unit mc-chatbro
MC_CHATBRO_LABEL=local.mc-chatbro
