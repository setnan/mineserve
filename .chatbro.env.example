# chatbro.py: which AI model answers "ai …" in the Minecraft chat. Read by chatbro.py, never by Docker.
# Copy to .chatbro.env and keep it private (chmod 600), then: ./mc.sh chatbro restart
# Keys stay in this file only; it is ignored by git and never sent anywhere except to the provider you pick.
#
# CHATBRO_PROVIDER, pick one:
#   codex       OpenAI Codex CLI with your ChatGPT plan (npm install -g @openai/codex && codex login), no key here
#   openai      OpenAI API                 key: platform.openai.com            model e.g. the gpt model you want
#   anthropic   Anthropic API              key: console.anthropic.com          default model claude-sonnet-5-5
#   gemini      Google Gemini API          key: aistudio.google.com            model e.g. a gemini flash model
#   openrouter  hundreds of models, one key: openrouter.ai                     model e.g. vendor/model-name
#   mistral     Mistral API                key: console.mistral.ai
#   groq        Groq API (fast)            key: console.groq.com
#   deepseek    DeepSeek API               key: platform.deepseek.com          default model deepseek-chat
#   glm         Z.ai GLM                   key: z.ai                           default model glm-4.7-flash (free)
#   ollama      local models, no key       ollama.com, then: ollama pull qwen3:14b   (default qwen3:14b)
#   lmstudio    local models, no key       lmstudio.ai, start its server
#   openai-compatible   any other OpenAI-compatible service: set CHATBRO_BASE_URL (…/v1) as well
#   claude      Claude Code CLI with your Claude plan (no key here); builds directly, no super tools
CHATBRO_PROVIDER=codex
#CHATBRO_API_KEY=
#CHATBRO_MODEL=
#CHATBRO_BASE_URL=

# Your own skin from the skins/ folder ("ai skin <name>") is signed by mineskin.org (Minecraft only shows signed
# player skins). Free key: account.mineskin.org/keys. Not needed for helper skins ("ai helper skin <name>").
#MINESKIN_API_KEY=

# What the bot is called in the game and the word(s) that start a request (comma-separated).
#CHATBRO_NAME=AI
#CHATBRO_KEYWORDS=ai
# The server owner (may use /master and /masteroff). Default: the first name in OPS in .env.
#CHATBRO_MASTER=
